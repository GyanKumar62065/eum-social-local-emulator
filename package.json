{
  "name": "@gyankumar62065/eum-social-local-emulator",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.12",
  "description": "Local development emulator for AWS End User Messaging Social",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GyanKumar62065/eum-social-local-emulator.git"
  },
  "homepage": "https://github.com/GyanKumar62065/eum-social-local-emulator#readme",
  "bugs": {
    "url": "https://github.com/GyanKumar62065/eum-social-local-emulator/issues"
  },
  "type": "module",
  "bin": {
    "eum-social-local-emulator": "bin/eum-social-local-emulator.js"
  },
  "files": [
    "bin/",
    "src/",
    "models/",
    "ui/dist/",
    "eum-social-local-emulator.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "prepack": "bun run ui:build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "models:update": "node scripts/update-models.ts",
    "ui:build": "vite build ui --config ui/vite.config.ts",
    "ui:dev": "vite ui --config ui/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-sns": "^3.1148.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@aws-sdk/client-socialmessaging": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "preact": "^11.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
